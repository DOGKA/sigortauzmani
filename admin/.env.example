NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-PUBLISHABLE-KEY
RESEND_API_KEY=YOUR-RESEND-API-KEY
RESEND_FROM_EMAIL=Sigorta Uzmanı <noreply@yourdomain.com>
# Veritabanında kayıtlı alıcı yoksa kullanılan sunucu tarafı yedek adres.
NOTIFY_TO_EMAIL=sigorta@sigortauzmani.net
ALLOWED_ORIGIN=http://localhost:5173

# Ödeme makbuzu satın alma anında hazır olmuyor; panel /api/makbuz ucundan
# sonradan istiyor. Değerler site projesindeki .env ile aynı.
IO_API_BASE_URL=https://YOUR-IO-HOST
IO_API_TOKEN=YOUR-IO-API-TOKEN

# Alınan makbuz adresini satin_almalar kaydına yazmak için. Tanımlı değilse
# indirme çalışır ama adres kalıcı olmaz, her seferinde IO'ya gidilir.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY
