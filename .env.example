VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-PUBLISHABLE-KEY
VITE_NOTIFY_API_URL=http://localhost:3001

# IO API (Sigorta Gross) — yalnızca sunucu tarafı, tarayıcıya sızmaması için
# VITE_ öneki KULLANILMAZ.
IO_API_BASE_URL=https://grs.sigortagross.com
IO_API_TOKEN=PARTNER-BEARER-TOKEN
# "Satış kanalı". Doküman geçerli değerleri listelemiyor ve örnekleri
# tutarsız (1/2/3); partnerin üretimdeki CRM'i her uçta 0 gönderiyor.
IO_KANAL=0
IO_3DS_ENABLED=false
# MERNİS kimlik sorgusu. Kapalı, çünkü sorgu sorgulanan kişinin telefonuna
# "Kayıt İşlemi Onay kodunuz" SMS'i yolluyor ve bu istemciden kapatılamıyor
# (KodGonder: false ve Cep'i hiç göndermemek işe yaramıyor). Sigorta Gross
# partner token'ımız için onay kodunu kapatırsa true yapılabilir.
IO_MERNIS_ENABLED=false

# Tüm ziyaretçiler için ortak saatlik teklif tavanı. IP başına limit toplamı
# sınırlamadığı için gerekli: karşı taraf tek operatör hacmi için tasarlandı.
# Boş bırakılırsa 200 kullanılır.
IO_MAX_TEKLIF_GLOBAL_PER_HOUR=200

# Teklif oturumlarını yazmak için (RLS'i bypass eder, asla tarayıcıya gitmez)
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# Anonim oturum çerezini imzalamak için: openssl rand -hex 32
SESSION_SECRET=RANDOM-32-BYTE-HEX
